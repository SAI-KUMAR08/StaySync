# Copy to .env.development (local) or set in the Vercel project (production)
# --- Production build (Vercel static frontend + Railway backend) ---
# REQUIRED on Vercel (build-time): the client derives BOTH the axios /api base
# and the Socket.IO origin from this one variable. Without it the client falls
# back to same-origin /api, which no longer exists on Vercel.
# VITE_API_URL=https://<your-service>.up.railway.app

# --- Local dev (npm run dev) — leave VITE_API_URL unset ---
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000
# VITE_DEV_PROXY_TARGET=https://myhostel-server.up.railway.app

